{
  "max_inject_count": {
    "description": "单次最大注入条数",
    "hint": "每次模型请求中，最多同时注入的条目数量，防止注入内容过多导致回复混乱。0 表示不限制",
    "type": "int",
    "slider": {
      "min": 0,
      "max": 10,
      "step": 1
    },
    "default": 6
  },
  "allow_same_priority": {
    "description": "允许同优先级条目共存",
    "hint": "开启：优先级相同的条目同时生效；关闭：同优先级只保留最新触发的那个",
    "type": "bool",
    "default": true
  },
  "inject_position": {
    "description": "全局注入位置",
    "hint": "条目内容默认注入到哪里：user_input=本轮用户消息末尾（不影响历史记录与缓存，推荐）；system_prompt=系统提示词末尾。单个条目可在条目内单独覆盖此设置",
    "type": "string",
    "options": [
      "user_input",
      "system_prompt"
    ],
    "default": "user_input"
  },
  "entry_storage": {
    "description": "世界书条目",
    "type": "template_list",
    "hint": "世界书的核心配置区域。条目判决顺序：【启用 → 生效范围 → 触发词/定时 → 触发几率 → 触发冷却】，进入会话后由生效时长与生效次数决定能否注入。新手只需填写【条目名称】、【注入内容】、【触发词】即可使用；也可在聊天中用命令【添加条目 名称 内容】快速创建。推荐使用 WebUI 管理页可视化编辑",
    "templates": {
      "default": {
        "name": "世界书条目",
        "items": {
          "name": {
            "description": "条目名称",
            "hint": "条目的唯一标识，用于命令管理与 WebUI 编辑；可在 WebUI 或命令【重命名条目 旧名 新名】中修改",
            "type": "string",
            "default": "请输入名称"
          },
          "content": {
            "description": "注入内容",
            "hint": "条目被触发后注入给模型的内容，支持 {user_id} {user_name} {time} 等通配符",
            "type": "text",
            "default": "请输入注入内容"
          },
          "enabled": {
            "description": "启用",
            "hint": "条目总开关，关闭后完全不参与触发判断",
            "type": "bool",
            "default": true
          },
          "keywords": {
            "description": "触发词 / 正则",
            "hint": "触发方式：聊天消息命中其中任意一条（支持正则表达式）时触发。留空则不通过消息内容触发",
            "type": "list",
            "default": []
          },
          "priority": {
            "description": "优先级",
            "hint": "多个条目同时注入时的排列顺序，数字越小越靠前",
            "type": "int",
            "slider": {
              "min": 0,
              "max": 100,
              "step": 1
            },
            "default": 50
          },
          "probability": {
            "description": "触发几率",
            "hint": "满足所有触发条件后实际生效的概率。1=必定生效，0.5=一半概率，0.05=约5%（适合随机事件）",
            "type": "float",
            "slider": {
              "min": 0,
              "max": 1,
              "step": 0.01
            },
            "default": 1.0
          },
          "cooldown": {
            "description": "触发冷却（秒）",
            "hint": "条目激活后，在本会话的这段时间内不会再次激活。0 表示不冷却",
            "type": "int",
            "slider": {
              "min": 0,
              "max": 86400,
              "step": 60
            },
            "default": 0
          },
          "duration": {
            "description": "生效时长（秒）",
            "hint": "条目触发后的持续生效时间，到期自动失效。0 表示永久生效",
            "type": "int",
            "slider": {
              "min": 0,
              "max": 600,
              "step": 10
            },
            "default": 180
          },
          "times": {
            "description": "生效次数",
            "hint": "一个生效周期内最多注入的次数，达到上限后条目失效。0 表示不限次数",
            "type": "int",
            "slider": {
              "min": 0,
              "max": 10,
              "step": 1
            },
            "default": 5
          },
          "scope": {
            "description": "生效范围",
            "hint": "限制条目在哪些会话生效，每行一条：用户ID / 群号 / 会话ID / admin（仅管理员），留空表示所有会话生效",
            "type": "list",
            "default": []
          },
          "inject_position": {
            "description": "注入位置",
            "hint": "本条目的注入位置。default=跟随上方全局设置；user_input=本轮用户消息末尾（缓存友好）；system_prompt=系统提示词末尾",
            "type": "string",
            "options": [
              "default",
              "system_prompt",
              "user_input"
            ],
            "default": "default"
          },
          "schedule": {
            "description": "定时配置",
            "hint": "结构化定时配置（由 WebUI 管理页可视化编辑生成），此处无需手动填写",
            "type": "string",
            "default": "",
            "invisible": true
          }
        }
      }
    }
  }
}
